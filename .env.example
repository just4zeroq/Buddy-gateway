# Buddy Gateway — example configuration
#
# Copy this file to `.env` and fill in your credentials. The bundled examples
# load it automatically (see `examples/common/mod.rs`).

# ---------------------------------------------------------------------------
# Telegram  (cargo run --example telegram_bot)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_HTTP_PROXY=
TELEGRAM_SHOW_TYPING=true
TELEGRAM_SHOW_THINKING=false
TELEGRAM_SHOW_TOOL_HINTS=true
# Comma/space separated Telegram user IDs; empty keeps the bot open to everyone.
TELEGRAM_ALLOWED_USER_IDS=
# Comma/space separated chat IDs (negative IDs allowed); empty keeps all chats.
TELEGRAM_ALLOWED_CHAT_IDS=
# always | mention | mention_or_reply — how a group activates the bot.
TELEGRAM_GROUP_ACTIVATION=always
# Accept a bare command (no @bot) in restricted group modes.
TELEGRAM_ALLOW_UNADDRESSED_COMMANDS=true
# Keep forum topics as separate subjects.
TELEGRAM_TOPIC_ISOLATION=false
# Quote the inbound message when replying.
TELEGRAM_REPLY_TO_MESSAGE=true
# Deliver edited messages (commands on edits are always rejected).
TELEGRAM_EDITED_MESSAGES=false
TELEGRAM_DISABLE_NOTIFICATION=false
TELEGRAM_PROTECT_CONTENT=false
TELEGRAM_LINK_PREVIEW=true
# Send audio parts as voice messages.
TELEGRAM_AUDIO_AS_VOICE=false

# ---------------------------------------------------------------------------
# Discord  (cargo run --example discord_bot)
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Feishu / Lark  (cargo run --example feishu_bot)
# ---------------------------------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---------------------------------------------------------------------------
# QQ Bot  (cargo run --example qq_bot)
# ---------------------------------------------------------------------------
QQ_APP_ID=
QQ_TOKEN=
QQ_SECRET=
QQ_SANDBOX=false

# ---------------------------------------------------------------------------
# WeCom / Enterprise WeChat  (cargo run --example wecom_bot)
# ---------------------------------------------------------------------------
WECOM_BOT_ID=
WECOM_SECRET=
WECOM_WS_URL=

# ---------------------------------------------------------------------------
# WeChat iLink  (cargo run --example weixin_bot)
# ---------------------------------------------------------------------------
WEIXIN_ACCOUNT_ID=
WEIXIN_TOKEN=
WEIXIN_BASE_URL=

# ---------------------------------------------------------------------------
# XiaoYi / Huawei OpenClaw  (cargo run --example xiaoyi_bot)
# ---------------------------------------------------------------------------
XIAOYI_AK=
XIAOYI_SK=
XIAOYI_AGENT_ID=
XIAOYI_WS_URL=
XIAOYI_WS_URL_BACKUP=
XIAOYI_SHOW_THINKING=false
XIAOYI_SHOW_TOOL_HINTS=true

# ---------------------------------------------------------------------------
# MQTT  (cargo run --example mqtt_bot)
# ---------------------------------------------------------------------------
MQTT_HOST=c14633a9.ala.cn-shenzhen.emqxsl.cn
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_SUBSCRIBE_TOPIC=devices/+/in
MQTT_PUBLISH_TOPIC=devices/{client_id}/out
MQTT_TLS_ENABLED=true
# Path to a CA PEM file (empty → system roots)
MQTT_TLS_CA_FILE=
MQTT_SHOW_THINKING=false
MQTT_SHOW_TOOL_HINTS=true

# ---------------------------------------------------------------------------
# Slack  (cargo run --example slack_bot)
#
# Socket Mode needs an app-level token (xapp-) *and* a bot token (xoxb-).
# Bot scopes: app_mentions:read, chat:write, channels:history, files:write.
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_CHANNEL_IDS=
SLACK_ALLOWED_USER_IDS=
SLACK_ALLOW_ALL_CHANNELS=false
SLACK_THREAD_REPLIES=true
SLACK_HTTP_PROXY=

# ---------------------------------------------------------------------------
# Webhook platforms  (cargo run --example webhook_server)
#
# Each platform is skipped unless its credentials are present, so you can
# configure just one. Register these callback URLs with the provider:
#   /webhooks/whatsapp  /webhooks/line  /webhooks/wechat  /webhooks/googlechat
# Terminate TLS in front of the process and forward the raw request body.
# ---------------------------------------------------------------------------
WEBHOOK_ADDR=0.0.0.0:8080
WEBHOOK_MEDIA_DIR=/tmp/buddy-gateway/media

# WhatsApp Cloud API  (Meta app → WhatsApp → Configuration)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_ALLOWED_USER_IDS=

# LINE Messaging API  (LINE Developers → Messaging API channel)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_USE_REPLY_TOKEN=true
LINE_ALLOWED_USER_IDS=
LINE_ALLOWED_GROUP_IDS=

# WeChat Official Account  (公众号后台 → 服务器配置)
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_TOKEN=
# 43-char Base64 EncodingAESKey; empty selects 明文模式
WECHAT_MP_ENCODING_AES_KEY=
# Empty or "success" means "no passive reply" (answer is sent via 客服消息)
WECHAT_MP_DEFAULT_REPLY=success

# Google Chat  (Chat API → Configuration → Connection settings)
# `access_token` must be pre-minted; see docs/CHANNELS.md §4 note 9.
GOOGLE_CHAT_ACCESS_TOKEN=
GOOGLE_CHAT_AUDIENCE=
GOOGLE_CHAT_BOT_USER=
GOOGLE_CHAT_VERIFY_JWT=true

# ---------------------------------------------------------------------------
# Advanced: push scheduler  (cargo run --example push_scheduler)
# ---------------------------------------------------------------------------
PUSH_INTERVAL_SECS=30
